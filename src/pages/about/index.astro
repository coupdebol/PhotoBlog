---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const portrait = {
  src: '/photos/30-91.jpg',
  alt: 'A photographer in black and white, looking down while holding an old camera.',
  credit: 'Jennifer Trovato',
  creditUrl: 'https://unsplash.com/photos/baRYCsjO6z4',
};
---

<BaseLayout title="About — Beautiful Blog" description="Who keeps this and why.">
  <Header />

  <main>
    <section class="about container">
      <h1>About</h1>

      <figure class="about__portrait">
        <img
          class="lightbox-trigger"
          src={portrait.src}
          alt={portrait.alt}
          loading="lazy"
          data-credit={portrait.credit}
          data-credit-url={portrait.creditUrl}
        />
        <figcaption class="meta">
          Photo: <a href={portrait.creditUrl} target="_blank" rel="noopener noreferrer">{portrait.credit}</a>
        </figcaption>
      </figure>

      <div class="about__body">
        <p>
          This is a personal photo journal, kept by one person for themselves and whoever wanders
          in — not a portfolio, not a brand, no client work behind it.
        </p>
        <p>
          What ends up here is undecided by design: a single frame that stopped me, a short photo
          essay from one walk, the occasional longer trip — posted as they're taken rather than
          planned in advance. The writing alongside each one is short on purpose; the photo is the
          point.
        </p>
        <p>
          Everything is dated on the way in and left as it was shot; nothing is re-edited later to
          look more finished than it was on the day it was posted.
        </p>
        <p class="about__note">
          This page — and every photo on this site right now — is placeholder content, written and
          sourced to show the shape the real thing will take. Replace the bio with your own, and
          replace the demo photos (credited to their real photographers below each one) with your
          own work before this goes anywhere public.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about {
    max-width: var(--measure);
    padding-block: 1.6rem 4rem;
  }

  .about h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    margin-bottom: 1.6rem;
  }

  .about__portrait {
    margin: 0 0 2rem;
    max-width: 22rem;
  }

  .about__portrait img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about__portrait figcaption {
    margin-top: 0.5rem;
  }

  .about__portrait figcaption a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .about__portrait figcaption a:hover {
    color: var(--accent);
  }

  .about__body {
    font-size: 1.1rem;
  }

  .about__body p {
    margin: 0 0 1.4em;
  }

  .about__note {
    color: var(--ink-faint);
    font-style: italic;
    border-top: 1px solid var(--rule);
    padding-top: 1.4em;
  }
</style>
