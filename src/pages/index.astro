---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PhotoGridItem from '../components/PhotoGridItem.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// The frontmatter no longer lists photos (they're inline <Photo /> tags in
// the MDX body), so the grid's "N photos" badge is derived by counting them
// in the raw source. Comments are stripped first so a commented-out tag
// isn't counted; a post with zero real <Photo /> tags is a genuine
// authoring bug (every entry needs at least one), so it's surfaced at
// build time rather than silently coerced to a plausible-looking count.
function countPhotos(post: (typeof posts)[number]) {
  const source = (post.body ?? '').replace(/\{\/\*[\s\S]*?\*\/\}/g, '');
  const count = (source.match(/<Photo\b/g) ?? []).length;
  if (count === 0) {
    console.warn(`[content] "${post.id}" has no <Photo /> tags in its body — check the entry.`);
  }
  return count;
}
---

<BaseLayout
  title="Beautiful Blog"
  description="A personal photography journal — photos and short notes, posted as they're taken."
>
  <Header />

  <main>
    <section class="hero container-wide">
      <h1>Photos, kept in order.</h1>
      <p class="hero__dek">
        A running photo journal — a frame or two at a time, with a short note alongside each.
      </p>
    </section>

    <section class="grid container-wide" aria-label="All entries">
      {
        posts.map((post) => {
          const photoCount = countPhotos(post);
          return (
            <PhotoGridItem
              href={`/posts/${post.id}/`}
              title={post.data.title}
              date={post.data.date}
              tag={post.data.tag}
              photoCount={photoCount}
              cover={post.data.cover}
            />
          );
        })
      }
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-block: 2.6rem 2rem;
    max-width: 34rem;
  }

  .hero h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    margin-bottom: 0.7rem;
  }

  .hero__dek {
    color: var(--ink-soft);
    font-size: 1.02rem;
    margin: 0;
  }

  .grid {
    padding-block: 0.6rem 4rem;
    column-count: 1;
    column-gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .grid {
      column-count: 2;
    }
  }

  @media (min-width: 1000px) {
    .grid {
      column-count: 3;
    }
  }
</style>
