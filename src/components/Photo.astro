---
interface Props {
  src: string;
  alt: string;
  orientation: 'landscape' | 'portrait';
  credit: string;
  creditUrl: string;
  caption?: string;
}

const { src, alt, orientation, credit, creditUrl, caption } = Astro.props;
---

<figure class="photo" data-orientation={orientation}>
  <img
    class="lightbox-trigger"
    src={src}
    alt={alt}
    loading="lazy"
    data-credit={credit}
    data-credit-url={creditUrl}
    data-caption={caption ?? ''}
  />
  <figcaption>
    {caption && <p class="photo__caption">{caption}</p>}
    <p class="photo__credit meta">
      Photo: <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a>
    </p>
  </figcaption>
</figure>

<style>
  .photo {
    margin-block: 2.4rem;
    /* Break out of the narrow reading column so photos can run wider
       than body text, without needing a separate wide-container wrapper
       around every inline photo. */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .photo img {
    width: 100%;
    max-width: 1100px;
    height: auto;
    display: block;
  }

  .photo[data-orientation='portrait'] img {
    max-width: 640px;
  }

  .photo figcaption {
    width: 100%;
    max-width: 1100px;
    margin-top: 0.6rem;
  }

  .photo__caption {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
    margin: 0 0 0.35rem;
  }

  .photo__credit {
    margin: 0;
  }

  .photo__credit a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .photo__credit a:hover {
    color: var(--accent);
  }
</style>
